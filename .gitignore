build_webos/
# Android build outputs and the local SDK path
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/app/.cxx/
!android/app/src/main/res/**/*.png
# IDE and editor settings
.vscode/
.idea/
*.user
