# NEVER commit the ROM or anything made from it (generated C, screenshots, traces).
rom/
*.sfc
*.SFC
work/
build*/
vendor/
saves/
*.cycstate
*.state
*.png
# ...except our own artwork and the release screenshots the README shows.
!assets/icon/*.png
!assets/signature.png
!docs/screenshots/*.png
!webos/*.png
*.wav
.DS_Store
dist/
out/
*.ipk
rom.cfg
src/gen/
recomp/funcs.h
*.sfc
*.smc
*.srm
*.tmp
*.log
*.csv
*.key
*.pem
*.pkcs*
last_run_report.json
