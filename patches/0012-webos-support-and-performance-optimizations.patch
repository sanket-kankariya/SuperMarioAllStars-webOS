+/* Nearest-neighbour backdrop for the self-test dump: the menu over the frozen
+ * game, as the player sees it. */
+static void RtDump(const char *path, const uint32_t *ov, int ow, int oh) {
+  FILE *f = fopen(path, "wb");
+  if (!f) return;
+  fprintf(f, "P6\n%d %d\n255\n", ow, oh);
+  for (int y = 0; y < oh; ++y)
+    for (int x = 0; x < ow; ++x) {
+      uint32_t bg = 0;
+      if (g_frozen_w > 0 && g_frozen_h > 0)
+        bg = ((const uint32_t *)g_frozen_frame)[(size_t)(y * g_frozen_h / oh) * g_frozen_w + x * g_frozen_w / ow];
+      uint32_t p = ov[(size_t)y * ow + x];
+      unsigned a = p >> 24;
+      unsigned r = (((p >> 16) & 255) * a + ((bg >> 16) & 255) * (255 - a)) / 255;
+      unsigned g = (((p >> 8) & 255) * a + ((bg >> 8) & 255) * (255 - a)) / 255;
+      unsigned b = ((p & 255) * a + (bg & 255) * (255 - a)) / 255;
+      fputc((int)r, f); fputc((int)g, f); fputc((int)b, f);
+    }
+  fclose(f);
+}
+
+/* The frozen game with the menu over it. */
+static void PresentFrozenWithRuntimeMenu(const char *dump_path) {
+  int ow = 0, oh = 0;
+  if (g_renderer_funcs.GetOutputSize) g_renderer_funcs.GetOutputSize(&ow, &oh);
+  if (ow <= 0 || oh <= 0) SDL_GetWindowSize(g_window, &ow, &oh);
+  const uint32_t *overlay = snes_rtmenu_gl_render(g_rtui, ow, oh);
+  if (overlay && dump_path) RtDump(dump_path, overlay, ow, oh);
+  g_rt_overlay_pixels = overlay;
+  g_rt_overlay_w = ow;
+  g_rt_overlay_h = oh;
+  const int draw_w = (g_frozen_w > 0 ? g_frozen_w : g_snes_width) * 2;
+  const int draw_h = (g_frozen_h > 0 ? g_frozen_h : g_snes_height) * 2;
+  uint8 *pixel_buffer = 0;
+  int pitch = 0;
+  g_renderer_funcs.BeginDraw(draw_w, draw_h, &pixel_buffer, &pitch);
+  if (pixel_buffer) {
+    if (g_frozen_w > 0 && g_frozen_h > 0)
+      snes_ovl_upscale_frame(pixel_buffer, pitch, draw_w, draw_h,
+                             (const uint32_t *)g_frozen_frame, g_frozen_w * 4,
+                             g_frozen_w, g_frozen_h);
+    else
+      memset(pixel_buffer, 0, (size_t)draw_h * (size_t)pitch);
+  }
+  g_renderer_funcs.EndDraw();
+  g_rt_overlay_pixels = NULL;
+}
+
+static int RtKeyToInput(int key) {
+  switch (key) {
+  case SDLK_UP: return RECOMP_RUNTIME_UI_INPUT_UP;
+  case SDLK_DOWN: return RECOMP_RUNTIME_UI_INPUT_DOWN;
+  case SDLK_LEFT: return RECOMP_RUNTIME_UI_INPUT_LEFT;
+  case SDLK_RIGHT: return RECOMP_RUNTIME_UI_INPUT_RIGHT;
+  case SDLK_RETURN: case SDLK_KP_ENTER: case SDLK_SPACE: return RECOMP_RUNTIME_UI_INPUT_ACCEPT;
+  case SDLK_BACKSPACE: return RECOMP_RUNTIME_UI_INPUT_BACK;
+  default: return -1;
+  }
+}
+
+static void RtPumpEvents(bool *running) {
+  SDL_Event event;
+  int ww = 0, wh = 0;
+  SDL_GetWindowSize(g_window, &ww, &wh);
+  while (SDL_PollEvent(&event)) {
+    if (HandleDeviceEvent(&event)) continue;
+    switch (event.type) {
+    case SDL_QUIT:
+      *running = false;
+      break;
+    case SDL_KEYDOWN: {
+      const int key = SNESRECOMP_SDL_EVENT_KEY(event);
+      if (key == SDLK_ESCAPE) { recomp_runtime_ui_close(g_rtui); break; }
+      const int in = RtKeyToInput(key);
+      if (in >= 0)
+        recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)in, 1,
+                                       SNESRECOMP_SDL_EVENT_REPEAT(event) ? 1 : 0);
+      break;
+    }
+    case SDL_KEYUP:
+      /* A key held across the close must not stay down in the guest. */
+      HandleInput(SNESRECOMP_SDL_EVENT_KEY(event), SNESRECOMP_SDL_EVENT_MOD(event), false);
+      break;
+    case SDL_MOUSEMOTION:
+      if (ww > 0 && wh > 0 && g_rt_overlay_w > 0)
+        snes_rtmenu_gl_mouse_pos((float)event.motion.x * g_rt_overlay_w / ww,
+                                 (float)event.motion.y * g_rt_overlay_h / wh);
+      break;
+    case SDL_MOUSEBUTTONDOWN:
+    case SDL_MOUSEBUTTONUP:
+      if (event.button.button == SDL_BUTTON_LEFT)
+        snes_rtmenu_gl_mouse_button(0, event.type == SDL_MOUSEBUTTONDOWN);
+      break;
+    default:
+      break;
+    }
+  }
+}
+
+/* Menu navigation from the pad: d-pad / left stick, A to accept, B to go back,
+ * with hold-to-repeat. */
+static void RtPadNav(uint32 *prev, uint32 *held_since, uint32 *last_repeat) {
+  static const struct { uint32 bit; int in; } kMap[] = {
+    { SNES_PAD_UP, RECOMP_RUNTIME_UI_INPUT_UP },     { SNES_PAD_DOWN, RECOMP_RUNTIME_UI_INPUT_DOWN },
+    { SNES_PAD_LEFT, RECOMP_RUNTIME_UI_INPUT_LEFT }, { SNES_PAD_RIGHT, RECOMP_RUNTIME_UI_INPUT_RIGHT },
+    { SNES_PAD_A, RECOMP_RUNTIME_UI_INPUT_ACCEPT },  { SNES_PAD_B, RECOMP_RUNTIME_UI_INPUT_BACK },
+  };
+  const uint32 now = SDL_GetTicks();
+  const uint32 pad = OverlayNavInputs();
+  for (size_t i = 0; i < sizeof(kMap) / sizeof(kMap[0]); ++i) {
+    const uint32 bit = kMap[i].bit;
+    const bool down = (pad & bit) != 0, was = (*prev & bit) != 0;
+    const bool movement = i < 4;
+    if (down && !was) {
+      recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)kMap[i].in, 1, 0);
+      if (movement) { *held_since = now; *last_repeat = now; }
+    } else if (down && movement && now - *held_since >= SNES_OVL_REPEAT_DELAY &&
+               now - *last_repeat >= SNES_OVL_REPEAT_RATE) {
+      recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)kMap[i].in, 1, 1);
+      *last_repeat = now;
+    }
+  }
+  *prev = pad;
+}
+
+static void RunRuntimeMenuLoop(bool *running) {
+  if (!RtEnsureMenu()) return;
+  host_report_breadcrumb("in-game menu OPEN - guest frozen until it closes (Esc, or Resume)");
+  const char *dump = HostGetenv("RUNTIME_MENU_DUMP");
+  /* Test hook: semantic inputs, one every 4 pumps, e.g. "down,down,accept". */
+  const char *script = HostGetenv("RUNTIME_MENU_SCRIPT");
+  g_overlay_modal = true;
+  SetAudioPaused(true);
+  snesrecomp_sdl_show_cursor(true);
+  recomp_runtime_ui_set_backdrop(g_rtui, RECOMP_RUNTIME_UI_DEFAULT_DIM, 1.0f);
+  recomp_runtime_ui_open(g_rtui);
+  uint32 prev = OverlayNavInputs(), held_since = 0, last_repeat = 0;
+  unsigned frames = 0;
+  while (recomp_runtime_ui_is_open(g_rtui) && *running) {
+    RtPumpEvents(running);
+    RtPadNav(&prev, &held_since, &last_repeat);
+    if (script && frames % 4 == 0 && frames / 4 < 64) {
+      const char *p = script;
+      for (unsigned n = frames / 4; n > 0 && p; --n) { p = strchr(p, ','); if (p) ++p; }
+      if (p && *p) {
+        int in = -1;
+        if (!strncmp(p, "down", 4)) in = RECOMP_RUNTIME_UI_INPUT_DOWN;
+        else if (!strncmp(p, "up", 2)) in = RECOMP_RUNTIME_UI_INPUT_UP;
+        else if (!strncmp(p, "left", 4)) in = RECOMP_RUNTIME_UI_INPUT_LEFT;
+        else if (!strncmp(p, "right", 5)) in = RECOMP_RUNTIME_UI_INPUT_RIGHT;
+        else if (!strncmp(p, "accept", 6)) in = RECOMP_RUNTIME_UI_INPUT_ACCEPT;
+        else if (!strncmp(p, "back", 4)) in = RECOMP_RUNTIME_UI_INPUT_BACK;
+        if (in >= 0) recomp_runtime_ui_handle_input(g_rtui, (RecompRuntimeUiInput)in, 1, 0);
+      }
+    }
+    PresentFrozenWithRuntimeMenu(frames == 40 ? dump : NULL);
+    if (HostGetenv("RUNTIME_MENU_SELFTEST") && frames >= (script ? 120u : 45u))
+      recomp_runtime_ui_close(g_rtui);
+    SDL_Delay(8);
+    frames++;
+  }
+  recomp_runtime_ui_close(g_rtui);
+  snesrecomp_sdl_show_cursor(g_cursor);
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  OverlayNoteClosed();
+  host_report_breadcrumb("in-game menu CLOSED after %u pumps - guest resuming", frames);
+  GameReset();
+}
