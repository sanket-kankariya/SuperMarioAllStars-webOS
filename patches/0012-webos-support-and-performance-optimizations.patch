+  else if (RtIsKey(it, RECOMP_RUNTIME_UI_KEY_WINDOW_SCALE)) *out = g_current_window_scale;
+  else if (RtIsKey(it, RECOMP_RUNTIME_UI_KEY_INTEGER_SCALE)) *out = g_config.integer_scale;
