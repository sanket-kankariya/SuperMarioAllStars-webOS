+typedef struct {
+    uint32 pc24;
+    const DispatchEntry *entry;
+    uint8 valid;
+} DispatchCacheEntry;
+
+#define DISPATCH_CACHE_SIZE 2048
+#define DISPATCH_CACHE_MASK (DISPATCH_CACHE_SIZE - 1)
+static DispatchCacheEntry s_dispatch_cache[DISPATCH_CACHE_SIZE];
+
 static const DispatchEntry *_cpu_dispatch_find(uint32 pc24) {
+    uint32 idx = (pc24 ^ (pc24 >> 8)) & DISPATCH_CACHE_MASK;
+    if (s_dispatch_cache[idx].valid && s_dispatch_cache[idx].pc24 == pc24) {
+        return s_dispatch_cache[idx].entry;
+    }
     unsigned lo = 0;
     unsigned hi = ACTIVE_DISPATCH_COUNT;
     while (lo < hi) {
         unsigned mid = lo + (hi - lo) / 2;
         uint32 mid_pc = ACTIVE_DISPATCH[mid].pc24;
-        if (mid_pc == pc24) return &ACTIVE_DISPATCH[mid];
+        if (mid_pc == pc24) {
+            s_dispatch_cache[idx].pc24 = pc24;
+            s_dispatch_cache[idx].entry = &ACTIVE_DISPATCH[mid];
+            s_dispatch_cache[idx].valid = 1;
+            return &ACTIVE_DISPATCH[mid];
+        }
         if (mid_pc < pc24) lo = mid + 1;
         else               hi = mid;
     }
+    s_dispatch_cache[idx].pc24 = pc24;
+    s_dispatch_cache[idx].entry = NULL;
+    s_dispatch_cache[idx].valid = 1;
     return NULL;
 }
 
